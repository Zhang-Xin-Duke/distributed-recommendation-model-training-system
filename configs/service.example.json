{
  "schema_version": 1,
  "run_id": "example-training-run",
  "listen": "127.0.0.1:9100",
  "partition": {"shard_id": 0, "shard_count": 1, "epoch": 1},
  "tables": [{
    "id": 1,
    "dimension": 128,
    "dtype": "float32",
    "optimizer": {
      "kind": "sparse_lazy_adam",
      "learning_rate": 0.001,
      "beta1": 0.9,
      "beta2": 0.999,
      "epsilon": 1e-8,
      "initial_beta1_power": 0.9,
      "initial_beta2_power": 0.999
    },
    "initialization": {"min": -0.01, "max": 0.01, "seed": 1}
  }],
  "access": {"policy": "cost_based", "switch_margin": 0.15},
  "cache": {
    "enabled": false,
    "admission": "reuse_cost",
    "network_bytes_per_window": 16777216,
    "staging_bytes_limit": 33554432,
    "max_inflight_batches": 2,
    "reserve_slot_fraction": 0.05
  },
  "limits": {
    "max_request_bytes": 16777216,
    "max_live_tickets": 1024,
    "cpu_state_bytes": 1073741824,
    "statistics_bytes": 16777216
  },
  "snapshot_directory": "./snapshots"
}
