{
  "schema_version": 1,
  "run_id": "example-training-run",
  "listen": "127.0.0.1:9100",
  "partition": {
    "shard_id": 0,
    "shard_count": 1,
    "epoch": 1
  },
  "tables": [
    {
      "id": 1,
      "dimension": 128,
      "dtype": "float32",
      "optimizer": {
        "kind": "sparse_lazy_adam",
        "learning_rate": 0.001,
        "beta1": 0.9,
        "beta2": 0.999,
        "epsilon": 1e-08,
        "initial_beta1_power": 0.9,
        "initial_beta2_power": 0.999
      },
      "initialization": {
        "min": -0.01,
        "max": 0.01,
        "seed": 1
      }
    }
  ],
  "access": {
    "policy": "cpu_only",
    "switch_margin": 0.15
  },
  "cache": {
    "enabled": false,
    "admission": "manual",
    "concurrent_agent_updates": true,
    "compact_gradients": true
  },
  "limits": {
    "max_request_bytes": 16777216,
    "max_live_tickets": 1024,
    "cpu_state_bytes": 1073741824,
    "ticket_payload_bytes": 67108864,
    "queue_payload_bytes": 67108864,
    "max_queued_operations": 1024,
    "max_active_operations": 16,
    "completion_waiters": 4,
    "dependency_payload_bytes": 67108864
  },
  "snapshot_directory": "./snapshots"
}
